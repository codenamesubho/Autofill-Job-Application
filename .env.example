# Copy to .env and fill in. .env is gitignored.
# The agent needs an LLM for every run; there is no offline path.

# Required. Key for whichever backend you route through.
AUTOFILL_LLM_API_KEY=sk-or-v1-...

# Required. For the default openrouter provider, use a provider/model string.
#   anthropic/claude-opus-5 | openai/gpt-4o | google/gemini-2.5-pro | ...
AUTOFILL_LLM_MODEL=anthropic/claude-opus-5

# Optional. Routing backend. Default: openrouter (needs no extra install).
#   openrouter | litellm | anthropic | openai | groq | google
# Talking straight to a vendor means AUTOFILL_LLM_MODEL is that vendor's own id
# (e.g. provider=anthropic with model=claude-opus-5, no prefix).
# AUTOFILL_LLM_PROVIDER=openrouter

# Optional. Override the endpoint (self-hosted gateway or proxy).
# AUTOFILL_LLM_BASE_URL=https://gateway.internal/v1

# Optional: override the Chrome binary (defaults to the macOS system install).
# AUTOFILL_CHROME_PATH=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
